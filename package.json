{
  "name": "narro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run prepare:icons",
    "build": "tsc && vite build",
    "prepare:icons": "tauri icon assets/branding/narro-logo-master.png && node scripts/sync-tray-icon.mjs",
    "check:config": "node scripts/verify-config.mjs",
    "check:rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml --locked",
    "check:rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features --locked -- -D warnings",
    "test:date-formatting": "node scripts/test-date-time-format.mjs",
    "test:ui-theme": "node scripts/test-ui-theme-tokens.mjs",
    "test:ui-typography": "node scripts/test-ui-typography.mjs",
    "test:ui-geometry": "node scripts/test-ui-geometry.mjs",
    "test:ui-motion": "node scripts/test-ui-motion.mjs",
    "test:ui-reduced-motion": "node scripts/test-ui-reduced-motion.mjs",
    "test:ui-overlay-primitives": "node scripts/test-ui-overlay-primitives.mjs",
    "test:ui-visual-fixtures": "node scripts/test-ui-visual-fixtures.mjs",
    "test:ui-app-shell": "node scripts/test-ui-app-shell.mjs",
    "test:ui-home-dashboard": "node scripts/test-ui-home-dashboard.mjs",
    "test:visual-regression:windows": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/capture-visual-fixtures.ps1 && node scripts/validate-visual-fixtures.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --all-targets --locked",
    "test:performance-harness": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/measure-floating.ps1 -SelfTest",
    "preflight:frontend": "npm run check:config && npm run test:date-formatting && npm run test:ui-theme && npm run test:ui-typography && npm run test:ui-geometry && npm run test:ui-motion && npm run test:ui-reduced-motion && npm run test:ui-overlay-primitives && npm run test:ui-visual-fixtures && npm run test:ui-app-shell && npm run test:ui-home-dashboard && npm run build",
    "preflight:windows": "npm run preflight:frontend && npm run check:rust:fmt && npm run check:rust && npm run check:rust:clippy && npm run test:rust && npm run test:performance-harness",
    "preflight": "npm run preflight:windows",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "@tauri-apps/cli": "^2"
  }
}
