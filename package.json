{
  "name": "narro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check:config": "node scripts/verify-config.mjs",
    "check:rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml --locked",
    "check:rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features --locked -- -D warnings",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --all-targets --locked",
    "preflight:frontend": "npm run check:config && npm run build",
    "preflight:windows": "npm run preflight:frontend && npm run check:rust:fmt && npm run check:rust && npm run check:rust:clippy && npm run test:rust",
    "preflight": "npm run preflight:windows",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "@tauri-apps/cli": "^2"
  }
}
